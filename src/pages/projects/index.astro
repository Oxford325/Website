---
import Layout from '../../layouts/Layout.astro';
import { getNotionProjects } from '../../lib/notion';

const feed = await getNotionProjects();
---

<Layout title="全部作品 — Oxford">
	<main class="listing">
		<nav><a href="/">← 首页</a><a href="/articles/">博客</a></nav>
		<p class="label">PROJECT ARCHIVE</p>
		<h1>全部作品</h1>
		<div class="items">
			{feed.projects.map((project, index) => (
				<a href={`/projects/${project.slug}/`}>
					<span>{String(index + 1).padStart(2, '0')}</span>
					<strong>{project.title}</strong>
					<small>{project.status || project.type} →</small>
				</a>
			))}
		</div>
	</main>
</Layout>

<style>
	.listing { max-width: 1180px; margin: 0 auto; padding: 48px 28px 120px; }
	nav { display: flex; justify-content: space-between; } nav a { color: var(--muted); text-decoration: none; font-size: 13px; }
	.label { margin: 130px 0 20px; color: var(--accent); font-size: 11px; letter-spacing: .18em; }
	h1 { margin: 0 0 70px; font-size: clamp(64px, 11vw, 150px); letter-spacing: -.07em; line-height: .9; }
	.items { border-top: 1px solid var(--line); }
	.items a { display: grid; grid-template-columns: 80px 1fr auto; align-items: center; min-height: 120px; border-bottom: 1px solid var(--line); text-decoration: none; }
	.items span, .items small { color: var(--muted); font-size: 11px; letter-spacing: .12em; }
	.items strong { font-size: clamp(28px, 4vw, 52px); letter-spacing: -.04em; }
</style>
